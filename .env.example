# Lab show - optional settings for an institution (a university, a school).
# Copy this file to ".env" next to the installed program ("Lab show.exe"), or into
# %APPDATA%\Lab show\.env, and fill in only what you use. Without any of it the app
# still works on the internet: it opens a free Cloudflare quick tunnel
# (https://<words>.trycloudflare.com) from the broadcasting device, no account needed.

# --- A fixed public address on the institution's own domain (Cloudflare named tunnel) ---
# In the Cloudflare dashboard: Zero Trust > Networks > Tunnels > Create a tunnel, add a
# public hostname (for example live.university.edu) pointing to http://localhost:47800,
# and copy the tunnel token here. LABSHOW_PORT must match that local port.
LABSHOW_PUBLIC_URL=
LABSHOW_TUNNEL_TOKEN=
LABSHOW_PORT=

# Turn the tunnel off entirely (direct connections and UPnP only): off
LABSHOW_TUNNEL=

# --- The institution's own TURN relay (optional) ---
# For example Cloudflare Realtime TURN, coturn, or another provider; "turns:" on port
# 443 passes almost every firewall. Comma-separated URLs.
#   LABSHOW_TURN_URLS=turns:turn.university.edu:443?transport=tcp,turn:turn.university.edu:3478
LABSHOW_TURN_URLS=
LABSHOW_TURN_USERNAME=
LABSHOW_TURN_CREDENTIAL=

# --- STUN servers (address discovery only; no picture passes through them) ---
# Default: stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
LABSHOW_STUN_URLS=

# --- Path to cloudflared, if not shipped with the app ---
LABSHOW_CLOUDFLARED=

# --- Old optional match-making relay (npm run relay); not needed by current links ---
LABSHOW_RELAY_URL=
