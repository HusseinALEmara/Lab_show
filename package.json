{
    "name": "lab-show",
    "productName": "Lab show",
    "version": "1.0.0",
    "description": "Lab show - Local Network Screen Sharing Desktop App",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win",
        "test": "node --test"
    },
    "build": {
        "appId": "com.labshow.desktop",
        "productName": "Lab show",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "server.js",
            "renderer/**/*",
            "package.json",
            "!.container/**",
            "!dist/**",
            "!bootstrap.ps1",
            "!install.bat",
            "!run.bat"
        ],
        "win": {
            "signAndEditExecutable": false,
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Lab show"
        }
    },
    "dependencies": {
        "express": "^4.21.0",
        "@nut-tree-fork/libnut-win32": "^2.7.5",
        "socket.io": "^4.8.1",
        "socket.io-client": "^4.8.1"
    },
    "devDependencies": {
        "electron": "^35.0.0",
        "electron-builder": "^25.1.8"
    }
}